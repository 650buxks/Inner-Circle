# Copy this file to `.env` (which Git ignores) and adjust values as needed:
#   cp .env.example .env
# Docker Compose and Django both read `.env`. Never commit real secrets.

DEBUG=True
# Generate a real one for production with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres and Redis containers from docker-compose.yml.
POSTGRES_DB=clique
POSTGRES_USER=clique
POSTGRES_PASSWORD=clique
DATABASE_URL=postgres://clique:clique@db:5432/clique
REDIS_URL=redis://redis:6379/0

# Added in later phases:
# ANTHROPIC_API_KEY=
# CLOUDINARY_URL=
